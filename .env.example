# Production & Local Environment Variables for Principal Academic Report Portal
PORT=3022
NODE_ENV=production

# Railway / MySQL Database Configuration
# You can set MYSQL_URL / DATABASE_URL connection string:
# MYSQL_URL=mysql://root:password@containers-us-west-123.railway.app:3306/railway
# DATABASE_URL=

# OR set individual MySQL parameters (supported natively on Railway & local DB):
MYSQLHOST=localhost
MYSQLUSER=akbgroups_user
MYSQLPASSWORD=bka@6202#db
MYSQLDATABASE=akbgroups_principal_report
MYSQLPORT=3306

# Standard aliases (DB_HOST, DB_USER, DB_PASSWORD, DB_NAME, DB_PORT) are also supported:
# DB_HOST=localhost
# DB_USER=akbgroups_user
# DB_PASSWORD=bka@6202#db
# DB_NAME=akbgroups_principal_report
# DB_PORT=3306
